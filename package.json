{
  "name": "fallow",
  "version": "0.4.0",
  "private": true,
  "description": "A ledger for the thinking you hand to AI. Fallow tracks which cognitive domains you offload, models how each one decays, and pushes back before you delegate work that keeps you sharp.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "seed": "tsx scripts/seed.ts",
    "reset": "tsx scripts/reset.ts",
    "attention": "tsx scripts/attention-sync.ts",
    "seed:demo": "tsx scripts/seed.ts --demo --force",
    "demo": "FALLOW_DEMO=1 next dev",
    "test:extension": "node integrations/browser-extension/test/run.mjs",
    "build:static": "bash scripts/build-static.sh",
    "serve:static": "npx serve out",
    "build:extension": "node scripts/build-extension.mjs",
    "pixel": "python3 scripts/pixel/brain.py && python3 scripts/pixel/tiles.py"
  },
  "dependencies": {
    "@fontsource/pixelify-sans": "^5.3.0",
    "next": "15.5.26",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.63.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=20.9"
  }
}
